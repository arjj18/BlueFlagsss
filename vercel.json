{
  "buildCommand": "cd artifacts/pit-lane && npm install && npm run build",
  "outputDirectory": "artifacts/pit-lane/dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
