{
  "framework": null,
  "buildCommand": "pnpm --filter @workspace/pit-lane run build",
  "outputDirectory": "dist",
  "installCommand": "npm install -g pnpm@10 && pnpm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
